{
  "name": "gene-engineering-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "validate": "node tools/validate-flow.mjs",
    "links": "node tools/check-links.mjs",
    "audit": "node tools/audit-layout.mjs --tag run",
    "smoke": "node tools/smoke-layout.mjs",
    "check": "npm run validate && npm run links && npm run build"
  },
  "dependencies": {
    "3dmol": "2.5.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
